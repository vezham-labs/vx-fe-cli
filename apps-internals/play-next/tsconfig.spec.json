{
  "extends": ["./tsconfig.app.json", "../../tsconfig.spec.json"],
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./out-tsc/vitest/tsconfig.spec.tsbuildinfo",
    "plugins": [],
    "lib": ["dom"],
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  },
  "include": [
    "__tests__/**/*.test.tsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "out-tsc"]
}
