{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/typecheck",
    "tsBuildInfoFile": "dist/typecheck/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
