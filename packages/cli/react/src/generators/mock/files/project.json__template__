{
  "name": "<%= projectName %>",
  "$schema": "<%= nxSchemaPath %>",
  "projectType": "application",
  "sourceRoot": "<%= projectRoot %>/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm serve"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm build"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm generate"
      }
    }
  },
  "tags": ["category:<%= category %>", "mock"]
}
