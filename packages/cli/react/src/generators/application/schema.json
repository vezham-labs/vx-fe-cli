{
  "$schema": "https://json-schema.org/schema",
  "$id": "Application",
  "title": "Create a Custom React Application",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the application.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the application?"
    },
    "category": {
      "type": "string",
      "description": "Application category that determines the project structure",
      "default": "internal",
      "enum": [
        "cdn",
        "pod",
        "suit",
        "platform",
        "widget",
        "internal",
        "app",
        "vezham",
        "doc",
        "demo"
      ],
      "x-prompt": {
        "message": "Which category should this application belong to?",
        "type": "list",
        "items": [
          {
            "value": "cdn",
            "label": "Cdns - Global CDNs applications"
          },
          {
            "value": "pod",
            "label": "Pods - Micro-People applications"
          },
          {
            "value": "suit",
            "label": "Suits - suit-bundle applications"
          },
          {
            "value": "platform",
            "label": "Platforms - CX platform applications"
          },
          {
            "value": "widget",
            "label": "Widgets - App Widgets applications"
          },
          {
            "value": "internal",
            "label": "Internal - Internal tools and utilities"
          },
          {
            "value": "app",
            "label": "Apps - Standard applications"
          },
          {
            "value": "vezham",
            "label": "Vezham Apps - For Public from vezham.com"
          },
          {
            "value": "doc",
            "label": "Doc Apps - Handbooks & roadmap, arch"
          },
          {
            "value": "demo",
            "label": "Demo Apps - Showcase & POC applications"
          }
        ]
      }
    },
    "cdnHost": {
      "type": "string",
      "description": "CDN config (cdn - static.vezham.com, self - self-hosting,..)",
      "default": "cdn",
      "enum": ["cdn", "self"]
    },
    "strict": {
      "type": "boolean",
      "description": "Creates an application with strict mode enabled.",
      "default": true
    },
    "directory": {
      "type": "string",
      "description": "Optional project group within the selected application category."
    }
  },
  "required": ["name", "category"]
}
