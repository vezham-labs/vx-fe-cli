{
  "name": "<%= projectName %>",
  "$schema": "<%= offsetFromRoot %>node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "<%= projectRoot %>/src",
  "targets": {
    "build": {
      "dependsOn": [
        "metadata:generate",
        "deploy:generate",
        "^build"
      ],
      "outputs": [
        "{projectRoot}/.output"
      ]
    },
    "dev": {
      "dependsOn": [
        "metadata:watch"
      ]
    },
    "hosts:setup": {},
    "deploy:generate": {},
    "metadata:generate": {},
    "metadata:watch": {},
    "routes:tanstack": {}
  },
  "tags": [
    "category:<%= category %>"
  ]
}
