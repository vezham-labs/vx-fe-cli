{
  "$schema": "https://json-schema.org/schema",
  "$id": "AppDoc",
  "title": "Create a documentation application",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the application.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the documentation application?"
    },
    "category": {
      "type": "string",
      "description": "Application category that determines project grouping.",
      "default": "internal",
      "enum": [
        "cdn",
        "pod",
        "suit",
        "platform",
        "widget",
        "internal",
        "app",
        "vezham",
        "doc",
        "demo"
      ]
    },
    "cdnHost": {
      "type": "string",
      "description": "CDN config (cdn - static.vezham.com, self - self-hosting).",
      "default": "cdn",
      "enum": ["cdn", "self"]
    },
    "strict": {
      "type": "boolean",
      "description": "Creates an application with strict mode enabled.",
      "default": true
    },
    "directory": {
      "type": "string",
      "description": "Optional project group within the selected category."
    }
  },
  "required": ["name", "category"]
}
