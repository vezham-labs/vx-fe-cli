{
  "$schema": "https://json-schema.org/schema",
  "$id": "AppDoc",
  "title": "Create a documentation application",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "description": "Application category that determines the project grouping.",
      "default": "internal",
      "enum": [
        "app",
        "showcase",
        "suite",
        "platform",
        "widget",
        "doc",
        "pod",
        "internal",
        "vezham"
      ],
      "x-prompt": {
        "message": "Which category should this project belong to?",
        "type": "list",
        "items": [
          {
            "value": "app",
            "label": "Apps - Standard applications"
          },
          {
            "value": "showcase",
            "label": "Showcases - Curated demos and examples"
          },
          {
            "value": "suite",
            "label": "Suites - Product suite applications"
          },
          {
            "value": "platform",
            "label": "Platforms - CX platform applications"
          },
          {
            "value": "widget",
            "label": "Widgets - App extensions, integrations, and chat widgets"
          },
          {
            "value": "doc",
            "label": "Docs - Handbooks, roadmaps, and architecture"
          },
          {
            "value": "pod",
            "label": "Pods - Shared SaaS infrastructure applications"
          },
          {
            "value": "internal",
            "label": "Internal - Internal tools and utilities"
          },
          {
            "value": "vezham",
            "label": "Vezham Apps - Public applications from vezham.com"
          }
        ]
      }
    },
    "name": {
      "type": "string",
      "description": "The name of the application.",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the documentation application?"
    },
    "directory": {
      "type": "string",
      "description": "Optional project group within the selected category.",
      "x-prompt": "Optional group within the category folder (leave blank for none):"
    },
    "cdnHost": {
      "type": "string",
      "description": "CDN config (cdn - static.vezham.com, self - self-hosting).",
      "default": "cdn",
      "enum": ["cdn", "self"]
    },
    "strict": {
      "type": "boolean",
      "description": "Creates an application with strict mode enabled.",
      "default": true
    }
  },
  "required": ["category", "name"]
}
