{
  "extends": [
    "<%= offsetFromRoot %>tsconfig.base.json",
    "<%= offsetFromRoot %>tsconfig.spec.json"
  ],
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
