{
  "extends": "<%= offsetFromRoot %>tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "<%= configTsconfigPath %>"
    }
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
