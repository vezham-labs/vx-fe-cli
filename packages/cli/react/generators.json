{
  "$schema": "https://json-schema.org/schema",
  "generators": {
    "init": {
      "factory": "./dist/generators/init/generator#initGenerator",
      "schema": "./dist/generators/init/schema.json",
      "description": "Initialize Vx CLI React generators in workspace"
    },
    "application": {
      "factory": "./dist/generators/application/generator#applicationGenerator",
      "schema": "./dist/generators/application/schema.json",
      "description": "Create a custom React application",
      "aliases": ["app"]
    },
    "app-cdn": {
      "factory": "./dist/generators/cdn/generator#cdnGenerator",
      "schema": "./dist/generators/cdn/schema.json",
      "description": "Create a CDN application (template pending)"
    },
    "app-doc": {
      "factory": "./dist/generators/doc/generator#docGenerator",
      "schema": "./dist/generators/doc/schema.json",
      "description": "Create a documentation application (template pending)"
    },
    "app-start": {
      "factory": "./dist/generators/start/generator#startGenerator",
      "schema": "./dist/generators/start/schema.json",
      "description": "Create a TanStack Start application"
    },
    "mock": {
      "factory": "./dist/generators/mock/generator#mockGenerator",
      "schema": "./dist/generators/mock/schema.json",
      "description": "Create a mock API project"
    },
    "library": {
      "factory": "./dist/generators/library/generator#libraryGenerator",
      "schema": "./dist/generators/library/schema.json",
      "description": "Create a TypeScript library package",
      "aliases": ["lib"]
    },
    "library-react": {
      "factory": "./dist/generators/library-react/generator#reactLibraryGenerator",
      "schema": "./dist/generators/library-react/schema.json",
      "description": "Create a React library package",
      "aliases": ["react-lib"]
    },
    "common": {
      "factory": "./dist/generators/common/generator#commonGenerator",
      "schema": "./dist/generators/common/schema.json",
      "description": "Create a common utilities library"
    },
    "component": {
      "factory": "./dist/generators/component/generator#componentGenerator",
      "schema": "./dist/generators/component/schema.json",
      "description": "Create a reusable React component library",
      "aliases": ["comp"]
    },
    "component-store": {
      "factory": "./dist/generators/component-store/generator#componentStoreGenerator",
      "schema": "./dist/generators/component-store/schema.json",
      "description": "Create a component library with state management",
      "aliases": ["comp-store"]
    },
    "core": {
      "factory": "./dist/generators/core/generator#coreGenerator",
      "schema": "./dist/generators/core/schema.json",
      "description": "Create a core business logic library"
    },
    "hook": {
      "factory": "./dist/generators/hook/generator#hookGenerator",
      "schema": "./dist/generators/hook/schema.json",
      "description": "Create a custom React hooks library"
    },
    "layout": {
      "factory": "./dist/generators/layout/generator#layoutGenerator",
      "schema": "./dist/generators/layout/schema.json",
      "description": "Create a layout components library"
    },
    "template": {
      "factory": "./dist/generators/template/generator#templateGenerator",
      "schema": "./dist/generators/template/schema.json",
      "description": "Create a template library for scaffolding"
    },
    "utilities": {
      "factory": "./dist/generators/utilities/generator#utilitiesGenerator",
      "schema": "./dist/generators/utilities/schema.json",
      "description": "Create a utilities and helper functions library",
      "aliases": ["utils"]
    }
  }
}
